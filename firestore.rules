rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Un utilisateur est admin si son document users/{uid} porte le rôle 'admin'.
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Toutes les collections de l'app sont au 1er niveau : on peut conditionner
    // la suppression sur le nom de la collection.
    // ⚠️ Un seul bloc match : les règles Firestore s'ADDITIONNENT (union). Un
    // second match /users/{uid} plus strict ne restreindrait rien, car ce
    // catch-all continuerait d'autoriser. Les exceptions sont donc traitées ici.
    match /{col}/{docId} {
      // Lecture : tout utilisateur connecté.
      allow read: if request.auth != null;

      // ÉCRITURE (création / mise à jour) :
      //  - users → ADMINS uniquement. Sinon n'importe quel utilisateur connecté
      //    pourrait éditer son propre profil, se donner role: 'admin', et
      //    contourner le verrou de suppression ci-dessous.
      //  - autres collections → tout utilisateur connecté (comportement inchangé).
      allow create, update: if col == 'users' ? isAdmin() : request.auth != null;

      // SUPPRESSION :
      //  - tickets de caisse (pos_tickets) et utilisateurs (users) → ADMINS uniquement (données sensibles) ;
      //  - toutes les autres collections → tout utilisateur connecté (comportement inchangé).
      allow delete: if (col == 'pos_tickets' || col == 'users') ? isAdmin() : request.auth != null;
    }
  }
}
