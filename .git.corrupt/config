[core]
	repositoryformatversion = 0
	filemode = true
	bare = false
	logallrefupdates = true
	ignorecase = true
	precomposeunicode = true
[remote "origin"]
	url = https://github.com/scylzo/Boulangerie-App.git
	fetch = +refs/heads/*:refs/remotes/origin/*
[branch "master"]
	remote = origin
	merge = refs/heads/master
	vscode-merge-base = origin/master
[branch "feat/design-system-artisan"]
	vscode-merge-base = origin/master
[remote "fork-source"]
	url = https://github.com/scylzo/boulangerie-app-fork.git
	fetch = +refs/heads/*:refs/remotes/fork-source/*
